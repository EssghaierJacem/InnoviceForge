# ===== Ports =====
GATEWAY_PORT=8080
INGESTION_PORT=8082
ANALYTICS_PORT=8083
PARSING_PORT=8084

POSTGRES_INGESTION_PORT=5433
POSTGRES_ANALYTICS_PORT=5434
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
KEYCLOAK_PORT=8181

# ===== Database credentials =====
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge

# ===== Service-to-service URLs (used by the gateway) =====
INGESTION_SERVICE_URL=http://localhost:8082
ANALYTICS_SERVICE_URL=http://localhost:8083

# ===== Infra hosts (localhost for local dev) =====
RABBITMQ_HOST=localhost
REDIS_HOST=localhost
MINIO_HOST=localhost

# ===== Keycloak =====
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8181
KEYCLOAK_ISSUER=http://localhost:8181/realms/invoiceforge

# Service-account client used by ingestion-service to assign tenant_id to
# freshly self-registered users via Keycloak's Admin REST API. The
# "backend-admin" client (realm-management "manage-users" + "view-users",
# both as service-account role AND client scope-mapping — see
# keycloak/realm-export.json) is declared in the realm import, secret and
# all, so this value must match the "secret" field on that client entry
# exactly — it's baked into the realm import, not a per-deployer secret to
# generate. (If you instead create the client by hand via the Admin
# Console, Keycloak generates a fresh one there and this becomes that
# value.)
KEYCLOAK_ADMIN_CLIENT_ID=backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ===== LLM =====
GEMINI_API_KEY=